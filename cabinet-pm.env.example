# Copy to cabinet-pm.env beside CabinetPM.exe, or to %APPDATA%\CabinetPM\cabinet-pm.env
# (AppData wins if both exist, and it survives installer upgrades.)
# Do not commit cabinet-pm.env.

# Update feed base (folder with version.json, or HTTP — recommended for tablets):
# CABINET_PM_UPDATE_URL=http://172.16.10.124:3090/tablet-updates
# Office SMB (often fails unless the tablet user has share access):
# CABINET_PM_UPDATE_URL=\\office-server\share\CabinetPM\updates
# GitHub Releases folder (installerUrl inside version.json must be a full https URL):
# CABINET_PM_UPDATE_URL=https://github.com/Chperry23/IBSAPPNEW/releases/latest/download
CABINET_PM_UPDATE_URL=
